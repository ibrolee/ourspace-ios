{
  "name": "ourspace-family",
  "version": "0.6.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit",
    "config:ios": "expo config --type public",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "doctor": "expo-doctor",
    "deps:check": "expo install --check",
    "build:ios:development": "eas build --platform ios --profile development",
    "build:ios:simulator": "eas build --platform ios --profile simulator",
    "preflight": "node scripts/preflight.mjs",
    "test": "node --test tests/*.test.mjs server/test/*.test.mjs"
  },
  "dependencies": {
    "expo": "~57.0.23",
    "expo-router": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-sqlite": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-dev-client": "~57.0.19",
    "expo-splash-screen": "~57.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
